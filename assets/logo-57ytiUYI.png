<svg width="200" height="200" xmlns="http://www.w3.org/2000/svg">
  <!-- Background Circle -->
  <circle cx="100" cy="100" r="90" fill="#4A90E2"/>
  
  <!-- Inner Circle -->
  <circle cx="100" cy="100" r="70" fill="#0A0E27"/>
  
  <!-- Book Icon -->
  <rect x="70" y="70" width="60" height="50" fill="#4A90E2" rx="3"/>
  <line x1="100" y1="70" x2="100" y2="120" stroke="#0A0E27" stroke-width="2"/>
  <line x1="70" y1="85" x2="130" y2="85" stroke="#0A0E27" stroke-width="1" opacity="0.5"/>
  <line x1="70" y1="95" x2="130" y2="95" stroke="#0A0E27" stroke-width="1" opacity="0.5"/>
  <line x1="70" y1="105" x2="130" y2="105" stroke="#0A0E27" stroke-width="1" opacity="0.5"/>
  
  <!-- Graduation Cap -->
  <polygon points="100,45 130,55 100,60 70,55" fill="#64B5F6"/>
  <rect x="98" y="60" width="4" height="15" fill="#64B5F6"/>
  <circle cx="100" cy="77" r="3" fill="#64B5F6"/>
</svg>
